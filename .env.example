# Firebase Client Web Configuration for LeoVantage Admin OS
# NOTE: VITE_ prefixed variables are embedded in client-side bundles.
# Security must be enforced via Firebase Authentication & Cloud Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
